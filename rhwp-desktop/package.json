{
  "name": "rhwp-desktop",
  "version": "0.1.24",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build:studio": "npm --prefix ../rhwp-studio run build",
    "build": "tauri build",
    "build:linux": "tauri build --config src-tauri/tauri.linux.conf.json --target x86_64-unknown-linux-gnu",
    "build:windows": "tauri build --config src-tauri/tauri.windows.conf.json --target x86_64-pc-windows-msvc",
    "build:windows:current-user": "tauri build --config src-tauri/tauri.windows.currentuser.conf.json --target x86_64-pc-windows-msvc",
    "e2e:installed": "node --test --test-concurrency=1 e2e/*.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "selenium-webdriver": "^4.33.0"
  }
}
