{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rhwp",
  "version": "0.1.18",
  "identifier": "io.rhwp.desktop",
  "build": {
    "beforeBuildCommand": "npm run build:studio",
    "frontendDist": "../../rhwp-studio/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "rhwp",
        "width": 1440,
        "height": 980,
        "minWidth": 960,
        "minHeight": 720,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "publisher": "rhwp contributors",
    "shortDescription": "Open desktop editor for HWP and HWPX documents",
    "longDescription": "rhwp opens, edits, and saves HWP/HWPX documents on Windows and Ubuntu.",
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 rhwp contributors",
    "icon": [
      "../../assets/logo/logo-32.png",
      "../../assets/logo/logo-128.png",
      "../../assets/logo/logo-512.png"
    ]
  }
}
