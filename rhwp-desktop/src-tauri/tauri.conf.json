{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rhwp",
  "version": "0.1.0",
  "identifier": "io.rhwp.desktop",
  "build": {
    "frontendDist": "../../rhwp-studio/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "rhwp",
        "width": 1440,
        "height": 980,
        "minWidth": 960,
        "minHeight": 720,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../assets/logo/logo-32.png",
      "../../assets/logo/logo-128.png",
      "../../assets/logo/logo-512.png"
    ]
  }
}
