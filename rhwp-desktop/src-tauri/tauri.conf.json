{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rhwp",
  "version": "0.1.0",
  "identifier": "io.rhwp.desktop",
  "build": {
    "frontendDist": "../../rhwp-studio/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "rhwp",
        "width": 1440,
        "height": 980,
        "minWidth": 960,
        "minHeight": 720,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.1-0"
        ]
      }
    }
  }
}
