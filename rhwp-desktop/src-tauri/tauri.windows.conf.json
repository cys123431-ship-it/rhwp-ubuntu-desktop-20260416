{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "rhwp contributors",
    "icon": [
      "icons/icon.ico",
      "../../assets/logo/logo-32.png",
      "../../assets/logo/logo-128.png",
      "../../assets/logo/logo-512.png"
    ],
    "fileAssociations": [
      {
        "ext": ["hwp"],
        "name": "HWP Document",
        "description": "Hangul Word Processor document",
        "mimeType": "application/x-hwp",
        "role": "Editor"
      },
      {
        "ext": ["hwpx"],
        "name": "HWPX Document",
        "description": "Hangul Word Processor XML document",
        "mimeType": "application/vnd.hancom.hwpx",
        "role": "Editor"
      }
    ],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "../packaging/windows/sign.ps1",
          "%1"
        ]
      },
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "nsis": {
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": ["en-US"],
        "upgradeCode": "7E533CD5-C197-4DC9-82DC-0208A42B883C"
      }
    }
  }
}
